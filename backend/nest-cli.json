{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": false
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src"
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src"
    },
    "matching-service": {
      "type": "application",
      "root": "apps/matching-service",
      "entryFile": "main",
      "sourceRoot": "apps/matching-service/src"
    },
    "realtime-service": {
      "type": "application",
      "root": "apps/realtime-service",
      "entryFile": "main",
      "sourceRoot": "apps/realtime-service/src"
    },
    "social-service": {
      "type": "application",
      "root": "apps/social-service",
      "entryFile": "main",
      "sourceRoot": "apps/social-service/src"
    },
    "safety-service": {
      "type": "application",
      "root": "apps/safety-service",
      "entryFile": "main",
      "sourceRoot": "apps/safety-service/src"
    }
  }
}
