generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  age                  Int?
  createdAt            DateTime          @default(now())
  genderPreference     String?
  interests            String?
  isBanned             Boolean           @default(false)
  isSuspended          Boolean           @default(false)
  language             String            @default("en")
  passwordHash         String?
  pronouns             String?
  timezone             String            @default("UTC")
  trustScore           Int               @default(100)
  updatedAt            DateTime          @default(now()) @updatedAt
  username             String?
  voiceComfort         String?
  lastUsernameChangeAt DateTime?
  bio                  String?
  conversationIntent   String?
  readReceipts         Boolean           @default(true)
  role                 String            @default("user") @db.VarChar(50)
  badges               Badge[]
  blocks2              Block[]           @relation("Blocked")
  blocks               Block[]           @relation("Blocker")
  chats                Chat[]            @relation("ChatUser1")
  chats2               Chat[]            @relation("ChatUser2")
  matchLikesSent       MatchLike[]       @relation("LikeSender")
  matchLikesReceived   MatchLike[]       @relation("LikeTarget")
  matchPassesSent      MatchPass[]       @relation("PassSender")
  messages             Message[]
  notificationsActor   Notification[]    @relation("NotificationActor")
  notifications        Notification[]    @relation("NotificationUser")
  postComments         PostComment[]
  postLikes            PostLike[]
  postShares           PostShare[]       @relation("UserSharedPosts")
  posts                Post[]
  profile              Profile?
  promptAnswers        PromptAnswer[]
  reports2             Report[]          @relation("Reported")
  reports              Report[]          @relation("Reporter")
  rooms                RoomUser[]
  savedConnections     SavedConnection[] @relation("SavedUser1")
  savedConnections2    SavedConnection[] @relation("SavedUser2")
  userFeedback         UserFeedback[]    @relation("FeedbackFrom")
  userFeedback2        UserFeedback[]    @relation("FeedbackTo")
   voiceSessions        VoiceSession[]    @relation("VoiceUser1")
   voiceSessions2       VoiceSession[]    @relation("VoiceUser2")
   auditLogs            AuditLog[]        @relation("AdminAuditLogs")
   aiInsights           AIUserInsight?
   auditSessions        AuditSession[]    @relation("UserAuditSessions")
   adminSessions        AuditSession[]    @relation("AdminAuditSessions")

   @@map("users")
 }

model Mood {
  id          String @id @default(uuid())
  name        String @unique
  emoji       String
  description String
  category    String
  color       String

  @@map("moods")
}

model ConversationIntent {
  id          String  @id @default(uuid())
  name        String  @unique
  description String
  icon        String
  isCasual    Boolean @default(false)

  @@map("conversation_intents")
}

model Prompt {
  id         String         @id @default(uuid())
  category   String
  difficulty String
  dailyTheme String?
  expiresAt  DateTime?
  isActive   Boolean        @default(true)
  isDaily    Boolean        @default(false)
  text       String
  type       String
  answers    PromptAnswer[]
  rooms      Room[]

  @@map("prompts")
}

model Room {
  id          String     @id @default(uuid())
  name        String
  description String
  theme       String
  createdAt   DateTime   @default(now())
  isVoice     Boolean    @default(false)
  promptId    String?
  chats       Chat[]
  users       RoomUser[]
  prompt      Prompt?    @relation(fields: [promptId], references: [id])

  @@index([promptId])
  @@map("rooms")
}

model Profile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  pronouns           String?
  interests          String?
  voiceOpen          Boolean   @default(false)
  updatedAt          DateTime  @default(now()) @updatedAt
  coverPhotoUrl      String?   @map("cover_photo_url")
  currentCity        String?   @map("current_city")
  dateOfBirth        DateTime? @map("date_of_birth")
  education          String?
  gender             String?
  hometown           String?
  intro              String?
  profilePhotoUrl    String?   @map("profile_photo_url")
  relationshipStatus String?   @map("relationship_status")
  workPlace          String?   @map("work_place")
  workTitle          String?   @map("work_title")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model PromptAnswer {
  id        String   @id @default(uuid())
  userId    String
  promptId  String
  answer    String
  createdAt DateTime @default(now())
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([promptId])
  @@map("prompt_answers")
}

model Chat {
  id               String            @id @default(uuid())
  status           String            @default("active")
  archivedAt       DateTime?
  endedAt          DateTime?
  roomId           String?
  startedAt        DateTime          @default(now())
  user1Id          String
  user2Id          String
  room             Room?             @relation(fields: [roomId], references: [id])
  user1            User              @relation("ChatUser1", fields: [user1Id], references: [id])
  user2            User              @relation("ChatUser2", fields: [user2Id], references: [id])
  messages         Message[]
  reports          Report[]
  savedConnections SavedConnection[]
  userFeedback     UserFeedback[]
  voiceSessions    VoiceSession[]

  @@index([user1Id])
  @@index([user2Id])
  @@index([roomId])
  @@map("chats")
}

model Message {
  id                   String    @id @default(uuid())
  content              String    @db.Text
  chatId               String
  createdAt            DateTime  @default(now())
  moderationStatus     String    @default("approved")
  senderId             String
  deliveredAt          DateTime?
  isDeletedForEveryone Boolean   @default(false)
  readAt               DateTime?
  deletedByRecipient   Boolean   @default(false)
  deletedBySender      Boolean   @default(false)
  clientId             String?
  chat                 Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender               User      @relation(fields: [senderId], references: [id])

  @@index([chatId])
  @@index([senderId])
  @@index([clientId])
  @@map("messages")
}

model VoiceSession {
  id              String    @id @default(uuid())
  status          String    @default("requested")
  chatId          String
  durationSeconds Int?
  endedAt         DateTime?
  startedAt       DateTime?
  user1Id         String
  user2Id         String
  chat            Chat      @relation(fields: [chatId], references: [id])
  user1           User      @relation("VoiceUser1", fields: [user1Id], references: [id])
  user2           User      @relation("VoiceUser2", fields: [user2Id], references: [id])

  @@index([user1Id])
  @@index([user2Id])
  @@index([chatId])
  @@map("voice_sessions")
}

model Report {
  id          String   @id @default(uuid())
  description String?
  status      String   @default("pending")
  chatId      String?
  createdAt   DateTime @default(now())
  reason      String
  reportedId  String
  reporterId  String
  chat        Chat?    @relation(fields: [chatId], references: [id])
  reported    User     @relation("Reported", fields: [reportedId], references: [id])
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([reportedId])
  @@index([chatId])
  @@map("reports")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Badge {
  id        String   @id @default(uuid())
  userId    String
  badgeType String
  count     Int      @default(1)
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("badges")
}

model SavedConnection {
  id      String   @id @default(uuid())
  label   String?
  chatId  String?
  savedAt DateTime @default(now())
  user1Id String
  user2Id String
  chat    Chat?    @relation(fields: [chatId], references: [id])
  user1   User     @relation("SavedUser1", fields: [user1Id], references: [id])
  user2   User     @relation("SavedUser2", fields: [user2Id], references: [id])

  @@unique([user1Id, user2Id])
  @@index([user2Id])
  @@index([chatId])
  @@map("saved_connections")
}

model UserFeedback {
  id         String   @id @default(uuid())
  attributes String?
  chatId     String
  createdAt  DateTime @default(now())
  fromUserId String
  toUserId   String
  chat       Chat     @relation(fields: [chatId], references: [id])
  fromUser   User     @relation("FeedbackFrom", fields: [fromUserId], references: [id])
  toUser     User     @relation("FeedbackTo", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
  @@index([chatId])
  @@map("user_feedback")
}

model RoomUser {
  id       String    @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("room_users")
}

model Post {
  id            String        @id @default(cuid())
  userId        String
  content       String
  imageUrl      String?
  isDarkMeme    Boolean       @default(false)
  likesCount    Int           @default(0)
  commentsCount Int           @default(0)
  sharesCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  comments      PostComment[]
  likes         PostLike[]
  shares        PostShare[]   @relation("SharedOriginalPost")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
  @@map("post_comments")
}

model PostShare {
  id             String   @id @default(cuid())
  originalPostId String
  sharedByUserId String
  createdAt      DateTime @default(now())
  originalPost   Post     @relation("SharedOriginalPost", fields: [originalPostId], references: [id], onDelete: Cascade)
  sharedByUser   User     @relation("UserSharedPosts", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  @@index([originalPostId])
  @@index([sharedByUserId])
  @@map("post_shares")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  actorId    String
  targetId   String?
  targetType String?
  read       Boolean  @default(false)
  data       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  actor      User     @relation("NotificationActor", fields: [actorId], references: [id])
  user       User     @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([actorId], map: "notifications_actorId_fkey")
  @@map("notifications")
}

model MatchLike {
  id        String    @id @default(uuid())
  senderId  String
  targetId  String
  type      String    @default("like")
  message   String?   @db.Text
  isMatch   Boolean   @default(false)
  matchedAt DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  sender    User      @relation("LikeSender", fields: [senderId], references: [id], onDelete: Cascade)
  target    User      @relation("LikeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([senderId, targetId])
  @@index([targetId])
  @@index([createdAt])
  @@map("match_likes")
}

model MatchPass {
  id        String   @id @default(uuid())
  senderId  String
  targetId  String
  createdAt DateTime @default(now())
  sender    User     @relation("PassSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, targetId])
  @@index([targetId])
  @@map("match_passes")
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String   // e.g., "USER_BAN", "ROLE_CHANGE", "REPORT_RESOLVE"
  entityType   String   // e.g., "USER", "REPORT", "VOICE_CALL"
  entityId     String
  adminId      String
  targetUserId String?
  sessionId    String?
  metadata     Json?
  isSensitive  Boolean  @default(false) @map("isSensitive") @db.TinyInt
  details      String?  @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  admin User @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model AIUserInsight {
  id               String   @id @default(uuid())
  userId           String   @unique
  userType         String   @map("user_type") @db.VarChar(50)
  engagementLevel  String   @map("engagement_level") @db.VarChar(20)
  activityPattern  String   @map("activity_pattern") @db.VarChar(20)
  riskLevel        RiskLevel @map("risk_level")
  anomalyDetected  Boolean  @map("anomaly_detected") @db.TinyInt
  intentSummary    Json     @map("intent_summary")
  alerts           Json
  recommendation   Json
  behaviorSummary  String   @map("behavior_summary") @db.Text
  aiConfidence     String   @map("ai_confidence") @db.VarChar(20)
  aiModel          String   @map("ai_model") @db.VarChar(100)
  aiVersion        String   @map("ai_version") @db.VarChar(50)
  feedbackNotes    String?  @map("feedback_notes") @db.Text
  generatedAt      DateTime @default(now()) @map("generatedAt")
  updatedAt        DateTime @updatedAt @map("updatedAt")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_user_insights")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AuditSession {
  id        String   @id @default(uuid())
  adminId   String
  userId    String
  reason    String   @db.Text
  startedAt DateTime @default(now())
  endedAt   DateTime?

  admin User @relation("AdminAuditSessions", fields: [adminId], references: [id])
  user  User @relation("UserAuditSessions", fields: [userId], references: [id])

  @@map("audit_sessions")
}

model AIInsightHistory {
  id              String   @id @default(uuid())
  userId          String
  insightId       String
  model           String   @db.VarChar(100)
  version         String   @db.VarChar(50)
  rawResponse     Json     @map("raw_response")
  behaviorSummary String   @map("behavior_summary") @db.Text
  confidence      String   @db.VarChar(20)
  createdAt       DateTime @default(now())

  @@map("ai_insight_history")
}

// ============================================
// GAMIFICATION & ENGAGEMENT SYSTEM
// ============================================

model UserLevel {
  id              String   @id @default(uuid())
  userId          String   @unique
  level           Int      @default(1)
  xp              Int      @default(0)
  totalXpEarned   Int      @default(0) @map("total_xp_earned")
  tier            String   @default("Newbie") // Newbie, Explorer, Charmer, Heartbreaker, Legend, Elite, Icon, Superstar, Celebrity, VIP
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_levels")
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique // first_match, hot_streak, century_club, etc.
  name        String
  description String   @db.Text
  category    String   // profile, matching, social, special
  icon        String   // emoji or icon name
  xpReward    Int      @default(0) @map("xp_reward")
  badgeUrl    String?  @map("badge_url")
  tier        String   @default("bronze") // bronze, silver, gold, platinum, diamond
  requirement String   @db.Text // JSON with requirements
  isSecret    Boolean  @default(false) @map("is_secret")
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  progress      Int      @default(0) // Current progress towards achievement
  isCompleted   Boolean  @default(false) @map("is_completed")
  completedAt   DateTime? @map("completed_at")
  earnedAt      DateTime @default(now()) @map("earned_at")

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

model DailyQuest {
  id          String   @id @default(uuid())
  key         String   @unique // swipe_20, match_3, send_5_messages, etc.
  name        String
  description String   @db.Text
  category    String   // daily, weekly, special
  xpReward    Int      @default(0) @map("xp_reward")
  itemReward  String?  @map("item_reward") // boost, compliment, etc.
  requirement String   @db.Text // JSON with quest requirements
  expiresAt   DateTime @map("expires_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  userQuests UserQuest[]

  @@map("daily_quests")
}

model UserQuest {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  questId     String   @map("quest_id")
  progress    Int      @default(0)
  isCompleted Boolean  @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  isClaimed   Boolean  @default(false) @map("is_claimed")
  claimedAt   DateTime? @map("claimed_at")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  quest DailyQuest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@index([questId])
  @@map("user_quests")
}

model UserStreak {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  currentStreak   Int      @default(0) @map("current_streak")
  longestStreak   Int      @default(0) @map("longest_streak")
  lastActiveDate  DateTime @map("last_active_date")
  streakFrozen    Boolean  @default(false) @map("streak_frozen") // Premium feature
  freezeCount     Int      @default(0) @map("freeze_count")
  totalDaysActive Int      @default(0) @map("total_days_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_streaks")
}

model UserStats {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  profileViews          Int      @default(0) @map("profile_views")
  profileViewsToday     Int      @default(0) @map("profile_views_today")
  profileViewsThisWeek  Int      @default(0) @map("profile_views_this_week")
  likesReceived         Int      @default(0) @map("likes_received")
  likesReceivedToday    Int      @default(0) @map("likes_received_today")
  likesSent             Int      @default(0) @map("likes_sent")
  superLikesReceived    Int      @default(0) @map("super_likes_received")
  superLikesSent        Int      @default(0) @map("super_likes_sent")
  matchesCount          Int      @default(0) @map("matches_count")
  matchesToday          Int      @default(0) @map("matches_today")
  messagesCount         Int      @default(0) @map("messages_count")
  messagesToday         Int      @default(0) @map("messages_today")
  firstMessagesSent     Int      @default(0) @map("first_messages_sent")
  repliesReceived       Int      @default(0) @map("replies_received")
  repliesSent           Int      @default(0) @map("replies_sent")
  averageResponseTime   Int?     @map("average_response_time") // in minutes
  matchRate             Float    @default(0.0) @map("match_rate") // percentage
  replyRate             Float    @default(0.0) @map("reply_rate") // percentage
  videoCallsCount       Int      @default(0) @map("video_calls_count")
  voiceCallsCount       Int      @default(0) @map("voice_calls_count")
  datesConfirmed        Int      @default(0) @map("dates_confirmed")
  complimentsSent       Int      @default(0) @map("compliments_sent")
  complimentsReceived   Int      @default(0) @map("compliments_received")
  boostsUsed            Int      @default(0) @map("boosts_used")
  lastResetDate         DateTime @default(now()) @map("last_reset_date")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("user_stats")
}

model UserElo {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  eloScore        Int      @default(1500) @map("elo_score") // Chess-style ELO rating
  attractiveness  Float    @default(50.0) // Percentile (0-100)
  popularity      Int      @default(0) // Calculated from likes, views, etc.
  activityScore   Int      @default(0) @map("activity_score")
  responsivenessScore Int  @default(50) @map("responsiveness_score")
  qualityScore    Int      @default(50) @map("quality_score") // Profile completeness + engagement
  lastCalculated  DateTime @default(now()) @map("last_calculated")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_elo")
}

model ProfileView {
  id          String   @id @default(uuid())
  viewerId    String   @map("viewer_id")
  viewedId    String   @map("viewed_id")
  viewedAt    DateTime @default(now()) @map("viewed_at")
  durationSec Int?     @map("duration_sec") // Time spent viewing
  source      String   @default("discovery") // discovery, search, profile_link

  @@index([viewerId])
  @@index([viewedId])
  @@index([viewedAt])
  @@map("profile_views")
}

model Compliment {
  id          String   @id @default(uuid())
  senderId    String   @map("sender_id")
  recipientId String   @map("recipient_id")
  type        String   // smile, style, bio, photos, vibe, funny, smart, creative
  message     String?  @db.Text
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@map("compliments")
}

model UserBoost {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String   @default("profile") // profile, priority_likes
  startedAt   DateTime @default(now()) @map("started_at")
  expiresAt   DateTime @map("expires_at")
  isActive    Boolean  @default(true) @map("is_active")
  source      String   @default("purchased") // purchased, reward, quest
  viewsGained Int      @default(0) @map("views_gained")
  likesGained Int      @default(0) @map("likes_gained")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_boosts")
}

model UserSubscription {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  tier            String   @default("free") // free, plus, gold, platinum
  status          String   @default("active") // active, cancelled, expired, paused
  startDate       DateTime @default(now()) @map("start_date")
  endDate         DateTime? @map("end_date")
  autoRenew       Boolean  @default(true) @map("auto_renew")
  paymentMethod   String?  @map("payment_method")
  amount          Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD")
  billingCycle    String   @default("monthly") // monthly, quarterly, yearly
  trialEndsAt     DateTime? @map("trial_ends_at")
  cancelledAt     DateTime? @map("cancelled_at")
  lastPaymentDate DateTime? @map("last_payment_date")
  nextBillingDate DateTime? @map("next_billing_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_subscriptions")
}

model NotificationSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  matchNotifications    Boolean  @default(true) @map("match_notifications")
  messageNotifications  Boolean  @default(true) @map("message_notifications")
  likeNotifications     Boolean  @default(true) @map("like_notifications")
  superLikeNotifications Boolean @default(true) @map("super_like_notifications")
  profileViewNotifications Boolean @default(false) @map("profile_view_notifications")
  questNotifications    Boolean  @default(true) @map("quest_notifications")
  achievementNotifications Boolean @default(true) @map("achievement_notifications")
  promotionalNotifications Boolean @default(true) @map("promotional_notifications")
  emailNotifications    Boolean  @default(true) @map("email_notifications")
  pushNotifications     Boolean  @default(true) @map("push_notifications")
  smsNotifications      Boolean  @default(false) @map("sms_notifications")
  quietHoursStart       Int?     @map("quiet_hours_start") // Hour (0-23)
  quietHoursEnd         Int?     @map("quiet_hours_end") // Hour (0-23)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

model DatingPreferences {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  ageMin              Int      @default(18) @map("age_min")
  ageMax              Int      @default(99) @map("age_max")
  maxDistance         Int      @default(50) @map("max_distance") // in km
  showMe              String   @default("everyone") // male, female, everyone, non_binary
  relationshipGoal    String?  @map("relationship_goal") // casual, serious, friendship, not_sure
  dealbreakers        String?  @db.Text // JSON array
  mustHaves           String?  @map("must_haves") @db.Text // JSON array
  heightMin           Int?     @map("height_min") // in cm
  heightMax           Int?     @map("height_max") // in cm
  education           String?  // Filter by education level
  hasKids             String?  @map("has_kids") // yes, no, no_preference
  wantsKids           String?  @map("wants_kids") // yes, no, maybe, no_preference
  smoking             String?  // never, socially, regularly, no_preference
  drinking            String?  // never, socially, regularly, no_preference
  religion            String?
  politics            String?
  ethnicity           String?  @db.Text // JSON array
  languages           String?  @db.Text // JSON array
  interests           String?  @db.Text // JSON array of required interests
  onlyShowVerified    Boolean  @default(false) @map("only_show_verified")
  onlyShowActive      Boolean  @default(false) @map("only_show_active") // Active within last 7 days
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("dating_preferences")
}

model IcebreakerTemplate {
  id          String   @id @default(uuid())
  category    String   // funny, flirty, deep, casual, question
  text        String   @db.Text
  useCount    Int      @default(0) @map("use_count")
  successRate Float    @default(0.0) @map("success_rate") // Reply rate
  isPremium   Boolean  @default(false) @map("is_premium")
  isActive    Boolean  @default(true) @map("is_active")
  tags        String?  @db.Text // JSON array
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("icebreaker_templates")
}

model XpTransaction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Int      // Can be positive or negative
  type        String   // earned, bonus, purchase, penalty
  source      String   // match, message, quest, achievement, daily_login, etc.
  description String   @db.Text
  metadata    String?  @db.Text // JSON with additional data
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("xp_transactions")
}

model UserEvent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  eventType   String   @map("event_type") // swipe_right, swipe_left, match, message_sent, profile_view, etc.
  targetId    String?  @map("target_id") // ID of the target user/item
  metadata    String?  @db.Text // JSON with event details
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
  @@map("user_events")
}

